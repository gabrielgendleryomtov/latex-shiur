% The maggidshiur version of a source sheet includes notes that are left out
% of the talmid version, which is the default.
\newif\ifshiur@maggidshiur
% A Hebrew-only version (translations=false) leaves out the English
% translations of Hebrew sources.
\newif\ifshiur@translations
\shiur@translationstrue
% An accessible handout is set in large print: accessible gives 18pt type, and
% accessible=<size> any other size. Slides are unchanged, since bigger type there
% would need different breaks.
\newcommand{\shiur@printsize}{}
\DeclareKeys[shiur]{
	maggidshiur .if = shiur@maggidshiur,
	talmid .code = \shiur@maggidshiurfalse,
	translations .if = shiur@translations,
	accessible .code = \def\shiur@printsize{#1},
	accessible .default:n = 18pt,
}
\ProcessKeyOptions[shiur]

% The same package serves articles and beamer presentations. An article that
% loads beamerarticle first can share its body with a beamer presentation.
\newif\ifshiur@beamer
\@ifclassloaded{beamer}{\shiur@beamertrue}{}
% Slides leave out the notes: they are shown to everyone, and notes would crowd
% the sources off them.
\ifshiur@beamer\ifshiur@maggidshiur
	\PackageWarningNoLine{shiur}{Slides leave out notes, so the maggidshiur option\MessageBreak is ignored}
	\shiur@maggidshiurfalse
\fi\fi
\newif\ifshiur@beamerarticle
\@ifpackageloaded{beamerarticle}{\shiur@beamerarticletrue}{}

\RequirePackage{etoolbox}
% bidi patches beamer's navigation code, which needs pgf, and beamerarticle
% doesn't load it. It also replaces itemize and description with beamer's,
% whose helpers aren't defined in article mode, and at the start of the
% document sets beamer's slide page style, whose header fails in an article;
% so keep the article's (they are restored once hebrew has loaded bidi, and
% once the document has begun).
\ifshiur@beamerarticle
	\RequirePackage{pgf}
	\let\shiur@itemize\itemize
	\let\shiur@description\@@description
	\let\shiur@ps@empty\ps@empty
\fi
\RequirePackage{polyglossia}
\RequirePackage{changepage}
\RequirePackage{graphicx}

%                         *****************
%                         ** PAGE LAYOUT **
%                         *****************

% Margins are relative to the paper size, so the class's paper options all work.
% Every page of an article has בס״ד in its header, the title page too.
\ifbool{shiur@beamer}{}{
	\RequirePackage[hmargin=1in, top=1in, bottom=1.2in, headheight=15pt,
		headsep=15pt, footskip=29pt, marginparwidth=.5in, marginparsep=5pt]{geometry}

	% scrextend scales every size command with the base size, fix-cm lets the
	% Computer Modern fallback and math fonts scale too, and the header grows to
	% hold the larger בס״ד. Large print reads better unjustified: ragged on the
	% right for English, and on the left for Hebrew (bidi's \raggedright is
	% physical, not by direction).
	\ifdefempty{\shiur@printsize}{}{%
		\RequirePackage{fix-cm}%
		\RequirePackage{scrextend}%
		\changefontsizes{\shiur@printsize}%
		\geometry{headheight=1.25\dimexpr\shiur@printsize\relax}%
		\AtBeginDocument{\raggedright}%
		\AtBeginEnvironment{hebrew}{\raggedleft}%
	}

	\RequirePackage{fancyhdr}
	\renewcommand{\headrulewidth}{0pt}
	\fancyhf{}
	\fancyhead[R]{\begin{hebrew}בס״ד\end{hebrew}}
	\fancyfoot[L]{\thepage}
	\pagestyle{fancy}
	% \maketitle gives the title page the plain style
	\fancypagestyle{plain}{}
}

\setcounter{secnumdepth}{0}
\setlength{\parindent}{0mm}
\setlength{\parskip}{0.5em}

