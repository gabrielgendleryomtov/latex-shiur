% The maggidshiur version of a source sheet includes notes that are left out
% of the talmid version, which is the default.
\newif\ifshiur@maggidshiur
% A Hebrew-only version (translations=false) leaves out the English
% translations of Hebrew sources.
\newif\ifshiur@translations
\shiur@translationstrue
% An accessible handout is set in large print: accessible gives 18pt type, and
% accessible=<size> any other size. Slides are unchanged, since bigger type there
% would need different breaks.
\newcommand{\shiur@printsize}{}
\DeclareKeys[shiur]{
	maggidshiur .if = shiur@maggidshiur,
	talmid .code = \shiur@maggidshiurfalse,
	translations .if = shiur@translations,
	accessible .code = \def\shiur@printsize{#1},
	accessible .default:n = 18pt,
}
\ProcessKeyOptions[shiur]

% The same package serves articles and beamer presentations. An article that
% loads beamerarticle first can share its body with a beamer presentation.
\newif\ifshiur@beamer
\@ifclassloaded{beamer}{\shiur@beamertrue}{}
\newif\ifshiur@beamerarticle
\@ifpackageloaded{beamerarticle}{\shiur@beamerarticletrue}{}

\RequirePackage{etoolbox}
% bidi patches beamer's navigation code, which needs pgf, and beamerarticle
% doesn't load it. It also replaces itemize and description with beamer's,
% whose helpers aren't defined in article mode, so keep the article's (they are
% restored once hebrew has loaded bidi).
\ifshiur@beamerarticle
	\RequirePackage{pgf}
	\let\shiur@itemize\itemize
	\let\shiur@description\@@description
\fi
\RequirePackage{polyglossia}
\RequirePackage{changepage}
\RequirePackage{graphicx}

