%                         ***********
%                         ** FONTS **
%                         ***********

% Hebrew text has three roles, each usable as the language of a mekorlang or a
% note: hebrew (rabbinic and other text), mikra (Tanakh, whose trop needs a font
% that places it well) and rashi (Rashi script). They differ only in font.
% \setshiurfont{role}[options]{font}[options] chooses a role's font, with
% fontspec's options. A role the document leaves unset gets the first installed
% font from its list below: mikra and rashi then fall back to the hebrew font,
% and hebrew to FreeSerif, which comes with TeX Live. A document that defines
% \hebrewfont (or, in beamer, \hebrewfontsf) itself keeps it.
\newcommand{\shiur@fonts@hebrew}{Taamey Frank CLM, Ezra SIL, Keter YG, Noto Serif Hebrew, FreeSerif}
\newcommand{\shiur@fonts@mikra}{Taamey Frank CLM, Taamey David CLM, Ezra SIL, SBL Hebrew, Keter YG}
\newcommand{\shiur@fonts@rashi}{Noto Rashi Hebrew}
% fonts known to place trop well, as they appear in a font's name or file,
% lowercased and without spaces or hyphens
\newcommand{\shiur@tropfonts}{taameyfrank, taameydavid, ezrasil, sblhebrew, keteryg}

\newif\ifshiur@hebrewset
\NewDocumentCommand{\setshiurfont}{m O{} m O{}}{%
	\ifstrequal{#1}{hebrew}{%
		\setfontfamily{\hebrewfont}[#2,#4]{#3}%
		\ifbool{shiur@beamer}{\setfontfamily{\hebrewfontsf}[#2,#4]{#3}}{}%
		\shiur@hebrewsettrue
	}{%
		\ifboolexpr{test{\ifstrequal{#1}{mikra}} or test{\ifstrequal{#1}{rashi}}}{%
			\expandafter\setfontfamily\csname shiur@font@#1\endcsname[#2,#4]{#3}%
			\csdef{shiur@fontname@#1}{#3}%
			\csdef{shiur@fontset@#1}{}%
		}{\PackageError{shiur}{Unknown font role `#1'}{The roles are hebrew, mikra and rashi.}}%
	}%
}

\ExplSyntaxOn
% #1 role: give it the first installed font from its list, if any
\cs_new_protected:Npn \shiur@fallbackfont #1
	{
		\clist_set:Nv \l_tmpa_clist { shiur@fonts@#1 }
		\clist_map_inline:Nn \l_tmpa_clist
			{
				\IfFontExistsTF {##1}
					{
						\str_if_eq:nnTF {#1} { hebrew }
							{ \setfontfamily \hebrewfont {##1} }
							{ \exp_args:Nc \setfontfamily { shiur@font@#1 } {##1} }
						\cs_set:cpn { shiur@fontname@#1 } {##1}
						\PackageInfo { shiur } { #1~font:~##1~(the~first~installed~from~its~list) }
						\clist_map_break:
					}
					{ }
			}
	}
\ExplSyntaxOff
% before polyglossia checks that the Hebrew font has Hebrew
\DeclareHookRule{begindocument/before}{shiur}{before}{polyglossia}
\AddToHook{begindocument/before}{%
	\ifboolexpr{bool{shiur@hebrewset} or test{\ifdef{\hebrewfont}}}{}{%
		\ifboolexpr{bool{shiur@beamer} and test{\ifdef{\hebrewfontsf}}}{}{%
			\shiur@fallbackfont{hebrew}%
			\ifbool{shiur@beamer}{\let\hebrewfontsf\hebrewfont}{}%
		}%
	}%
	\ifcsdef{shiur@fontset@mikra}{}{\shiur@fallbackfont{mikra}}%
	\ifcsdef{shiur@fontset@rashi}{}{\shiur@fallbackfont{rashi}}%
}

% #1 role: switch to its font, or stay in the hebrew font if it has none
\newcommand{\shiur@rolefont}[1]{\ifcsdef{shiur@font@#1}{\csuse{shiur@font@#1}}{}}

% A role's font may lack punctuation (Rashi fonts often have only Hebrew), so
% punctuation the current font lacks is set in the main Hebrew font. Runs with
% the role's font already selected. #1 role, #2 command that typesets the text,
% #3 text
\newcommand{\shiur@mainhebrewfont}{%
	\ifboolexpr{bool{shiur@beamer} and test{\ifdef{\hebrewfontsf}}}{\hebrewfontsf}{\hebrewfont}%
}
\newcommand{\shiur@punct}[1]{{\shiur@mainhebrewfont#1}}
\ExplSyntaxOn
\tl_new:N \l__shiur_text_tl
\tl_new:N \l__shiur_missing_tl
\regex_new:N \l__shiur_missing_regex
\cs_new_protected:Npn \shiur@withpunct #1 #2 #3
	{
		\tl_set:Nn \l__shiur_text_tl {#3}
		\str_if_eq:nnF {#1} { hebrew }
			{
				\tl_clear:N \l__shiur_missing_tl
				\tl_map_inline:nn { .,:;?!()"' }
					{
						\tex_iffontchar:D \font `##1 \scan_stop:
						\else:
							\tl_put_right:Nx \l__shiur_missing_tl
								{ \exp_not:N \x { \int_to_Hex:n { `##1 } } }
						\fi:
					}
				\tl_if_empty:NF \l__shiur_missing_tl
					{
						\exp_args:NNx \regex_set:Nn \l__shiur_missing_regex
							{ [ \exp_not:V \l__shiur_missing_tl ] }
						\regex_replace_all:NnN \l__shiur_missing_regex
							{ \c{shiur@punct} \cB\{ \0 \cE\} } \l__shiur_text_tl
					}
			}
		\exp_args:NV #2 \l__shiur_text_tl
	}
\ExplSyntaxOff

% The roles are all Hebrew. #1 language, #2 if it is Hebrew, #3 if not
\newcommand{\shiur@ifhebrew}[1]{%
	\ifboolexpr{test{\ifstrequal{#1}{hebrew}} or test{\ifstrequal{#1}{mikra}} or test{\ifstrequal{#1}{rashi}}}%
}

% Warn once if Tanakh text with trop is set in a font that isn't known to place
% trop well, unless the document chose that font for mikra itself. Runs with the
% font already selected. #1 text
\newif\ifshiur@tropwarned
\ExplSyntaxOn
\cs_new_protected:Npn \shiur@checktrop #1
	{
		\legacy_if:nF { shiur@tropwarned }
			{
				\cs_if_exist:cF { shiur@fontset@mikra }
					{
						\regex_match:nnT { [\x{0591}-\x{05AF}] } {#1}
							{
								\str_set:Nx \l_tmpa_str { \fontname \font }
								\str_set:Nx \l_tmpa_str { \str_lowercase:f { \l_tmpa_str } }
								\str_remove_all:Nn \l_tmpa_str { ~ }
								\str_remove_all:Nn \l_tmpa_str { - }
								\bool_set_false:N \l_tmpa_bool
								\clist_set:NV \l_tmpa_clist \shiur@tropfonts
								\clist_map_inline:Nn \l_tmpa_clist
									{
										\str_if_in:NnT \l_tmpa_str {##1}
											{ \bool_set_true:N \l_tmpa_bool \clist_map_break: }
									}
								\bool_if:NF \l_tmpa_bool
									{
										% the font's name without its features, folders or extension
										\str_set:Nx \l_tmpb_str { \fontname \font }
										\regex_replace_all:nnN { ["\[] } { } \l_tmpb_str
										\regex_replace_once:nnN { [\]/:] .* } { } \l_tmpb_str
										\regex_replace_once:nnN { \A .* / } { } \l_tmpb_str
										\regex_replace_once:nnN { \. (ttf|otf|TTF|OTF) \Z } { } \l_tmpb_str
										\global\shiur@tropwarnedtrue
										\PackageWarningNoLine { shiur }
											{
												Tanakh~text~with~trop~is~set~in~a~font~that~isn't~known~to~place~
												trop~well:~\l_tmpb_str.~Install~a~font~made~for~it,~such~as~
												Ezra~SIL~(on~Ubuntu:~sudo~apt~install~fonts-sil-ezra)~or~
												Taamey~Frank~CLM,~and~compile~again;~or~choose~a~font~with~
												\protect\setshiurfont{mikra}{...}.~See~"Fonts"~in~the~shiur~manual
											}
									}
							}
					}
			}
	}
\ExplSyntaxOff

%                         *************
%                         ** SOURCES **
%                         *************

% A mekor holds one source, usually as a hebrew and an english mekorlang. In
% beamer each mekor is a frame. mekor* continues the previous source without
% taking a new number.

\newcounter{mekor}
% the number of slides the current mekor needs, set by \shiur@parts
\newcounter{shiur@parts}
\newif\ifshiur@inmekor
% whether the current mekor has a hebrew mekorlang, which makes an english one
% after it a translation
\newif\ifshiur@hashebrew
\ifbool{shiur@beamer}{
	% #1 body
	\newcommand{\shiur@frame}[1]{%
		\frame{\setcounter{shiur@parts}{1}\global\shiur@hashebrewfalse\shiur@inmekortrue#1}%
	}
	\NewDocumentEnvironment{mekor}{+b}{\refstepcounter{mekor}\shiur@frame{#1}\vspace{0.5em}}{}
	\NewDocumentEnvironment{mekor*}{+b}{\shiur@frame{#1}\vspace{0.5em}}{}
}{
	\NewDocumentEnvironment{mekor}{}{\refstepcounter{mekor}\global\shiur@hashebrewfalse}{\vspace{0.5em}}
	\NewDocumentEnvironment{mekor*}{}{\global\shiur@hashebrewfalse}{\vspace{0.5em}}
}

% How the heading of a mekorlang differs between articles and beamer: the
% number sits in the margin of an article, but inline on a slide.
\ifbool{shiur@beamer}{
	\newcommand{\shiur@number}[1]{#1}
	\newcommand{\shiur@subtitlefont}{\small}
	\newcommand{\shiur@hebrewblock}[1]{\begin{flushright}#1\end{flushright}}
}{
	\newcommand{\shiur@number}[1]{\llap{#1}}
	\newcommand{\shiur@subtitlefont}{}
	\newcommand{\shiur@hebrewblock}[1]{#1}
}

% \mekorbreak splits a long source over several slides. Articles ignore it. In
% beamer, slide k of the mekor's frame shows part k of each mekorlang under its
% heading, with an ellipsis on both sides of the cut. \mekorbreak* cuts without
% one, for a break between sentences or paragraphs.
\NewDocumentCommand{\mekorbreak}{s}{\ignorespaces}
\newcommand{\shiur@ellipsis}{...}
\ExplSyntaxOn
% A part without the star of the break before it, and without the spaces and
% paragraph breaks around it, which would add an empty paragraph.
% #1 text
\cs_new_protected:Npn \shiur@trimpart #1
	{
		\tl_set:Nn \shiur@parttext {#1}
		\regex_replace_once:nnN { \A \c{relax}? \*? (?: \s | \c{par} )* } { } \shiur@parttext
		\regex_replace_once:nnN { (?: \s | \c{par} )* \Z } { } \shiur@parttext
	}
% The ellipsis at a break replaces any punctuation there, so "him." reads "him...".
% #1 text
\cs_new_protected:Npn \shiur@dropstop #1
	{
		\shiur@trimpart {#1}
		\regex_replace_once:nnN { [.,;:]+ \Z } { } \shiur@parttext
		\shiur@parttext
	}
\cs_new_protected:Npn \shiur@trimmed #1
	{
		\shiur@trimpart {#1}
		\shiur@parttext
	}
% A clean cut doesn't leave a slide ending in a comma.
% #1 text
\cs_new_protected:Npn \shiur@dropcomma #1
	{
		\shiur@trimpart {#1}
		\regex_replace_once:nnN { [,;]+ \Z } { } \shiur@parttext
		\shiur@parttext
	}
% #1 the text after a break, #2 if the break is \mekorbreak*, #3 if not
\cs_new_protected:Npn \shiur@ifstarred #1
	{
		\regex_match:nnTF { \A \* } {#1} { \use_i:nn } { \use_ii:nn }
	}
\ExplSyntaxOff
\ifbool{shiur@beamer}{
	\newcounter{shiur@part}
	% whether the break before the current part is marked with an ellipsis
	\newif\ifshiur@midbreak
	% #1 text
	\newcommand{\shiur@parts}[1]{%
		\setcounter{shiur@part}{0}%
		\shiur@midbreakfalse
		\shiur@nextpart\relax#1\mekorbreak\shiur@stop
	}
	% #1 this part, #2 the parts after it (the \relax keeps braces around a part)
	\long\def\shiur@nextpart#1\mekorbreak#2\shiur@stop{%
		\stepcounter{shiur@part}%
		\ifnumgreater{\value{shiur@part}}{\value{shiur@parts}}
			{\setcounter{shiur@parts}{\value{shiur@part}}}{}%
		\edef\shiur@before{\ifshiur@midbreak\noexpand\shiur@ellipsis\fi}%
		\ifblank{#2}
			{\ifnumequal{\value{shiur@part}}{1}{#1}{\shiur@part{\shiur@trimmed{#1}}{}}}
			{\shiur@ifstarred{#2}
				{\shiur@part{\shiur@dropcomma{#1}}{}\shiur@midbreakfalse}
				{\shiur@part{\shiur@dropstop{#1}}{\shiur@ellipsis}\shiur@midbreaktrue}%
			\shiur@nextpart\relax#2\shiur@stop}%
	}
	% #1 text, #2 what follows it
	\newcommand{\shiur@part}[2]{%
		\expandafter\only\expandafter<\the\value{shiur@part}>{\shiur@before#1#2}%
	}
	% Notes around a source go on its first and last slides.
	\newcommand{\shiur@firstslide}[1]{\ifshiur@inmekor\only<1>{#1}\else#1\fi}
	\newcommand{\shiur@lastslide}[1]{%
		\ifshiur@inmekor\expandafter\only\expandafter<\the\value{shiur@parts}>{#1}\else#1\fi
	}
}{
	\let\shiur@parts\@firstofone
	\let\shiur@firstslide\@firstofone
	\let\shiur@lastslide\@firstofone
}

% #1 number, #2 subtitle, #3 title, #4 text. \shiur@bodyfont sets the text's
% font; the heading stays in the language's main font.
\newcommand{\shiur@bodyfont}{}
\newcommand{\shiur@role}{hebrew}
\newcommand{\shiur@mekorlang}[4]{%
	\noindent\textbf{\shiur@number{#1.\hspace{1em}}}\textbf{#3}%
	\ifstrempty{#2}{}{\newline\shiur@subtitlefont\textit{#2}}%
	\par\vspace{0.5em}\noindent
	{\shiur@bodyfont\shiur@withpunct{\shiur@role}{\shiur@parts}{#4}\par}\vspace{1em}%
}

% \begin{mekorlang}[subtitle]{language}{title}
\NewDocumentEnvironment{mekorlang}{O{} m m +b}{%
	\shiur@ifhebrew{#2}
		{\global\shiur@hashebrewtrue
		\def\shiur@role{#2}%
		\def\shiur@bodyfont{\shiur@rolefont{#2}\ifstrequal{#2}{mikra}{\shiur@checktrop{#4}}{}}%
		\begin{hebrew}\shiur@hebrewblock{\shiur@mekorlang{\hebrewnumeral{\themekor}}{#1}{#3}{#4}}\end{hebrew}\par}
		{\ifboolexpr{not bool{shiur@translations} and bool{shiur@hashebrew}}
			{}
			{\shiur@mekorlang{\themekor}{#1}{#3}{#4}\par}}%
}{}

% Text for only one of the bilingual and Hebrew-only versions.
% #1 text with translations, #2 text without them
\newcommand{\iftranslations}[2]{\ifbool{shiur@translations}{#1}{#2}}

%                         ***********
%                         ** NOTES **
%                         ***********

% Notes for the maggid shiur, which are left out of the talmid version. Every
% kind of note looks the same: upright text beside a grey bar on the side where
% its lines start (bidi puts it on the right for Hebrew). Where a note sits
% already says whether it introduces a source or follows one; in beamer, a
% prenote goes on the first slide of a split source and a postnote on the last.
\RequirePackage{xcolor}
\RequirePackage{framed}
\newenvironment{shiur@notebar}
	{\def\FrameCommand{\hspace{1em}{\color{black!50}\vrule width 1.5pt}\hspace{0.8em}}%
	\MakeFramed{\advance\hsize-\width\FrameRestore}}
	{\endMakeFramed}
% #1 language, #2 text
\newcommand{\shiur@note}[2]{%
	\ifbool{shiur@maggidshiur}{%
		\shiur@ifhebrew{#1}
			{\begin{hebrew}\begin{shiur@notebar}\shiur@rolefont{#1}\shiur@withpunct{#1}{\@firstofone}{#2}\end{shiur@notebar}\end{hebrew}}
			{\begin{shiur@notebar}#2\end{shiur@notebar}}%
	}{}%
}

% beamer and beamerarticle already have a \note command, so they use gnote instead
\ifboolexpr{bool{shiur@beamer} or bool{shiur@beamerarticle}}{}{
	\NewDocumentEnvironment{note}{O{english} +b}{\shiur@note{#1}{#2}}{}
}
\NewDocumentEnvironment{gnote}{O{english} +b}{\shiur@note{#1}{#2}}{}
\NewDocumentEnvironment{prenote}{O{english} +b}{\shiur@firstslide{\shiur@note{#1}{#2}}}{}
\NewDocumentEnvironment{postnote}{O{english} +b}{\shiur@lastslide{\shiur@note{#1}{#2}}}{}

% Text in a box. It was called boxed, which clashes with amsmath's \boxed.
\newenvironment{boxedtext}{\begin{framed}}{\end{framed}}

