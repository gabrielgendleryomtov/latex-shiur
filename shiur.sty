% Margins are relative to the paper size, so the class's paper options all work.
\ifbool{shiur@beamer}{
	\newcommand{\makeTitle}{\maketitle}
}{
	\RequirePackage[hmargin=1in, top=1in, bottom=1.2in, headheight=15pt,
		headsep=15pt, footskip=29pt, marginparwidth=.5in, marginparsep=5pt]{geometry}

	% scrextend scales every size command with the base size, fix-cm lets the
	% Computer Modern fallback and math fonts scale too, and the header grows to
	% hold the larger בס״ד. Large print reads better unjustified: ragged on the
	% right for English, and on the left for Hebrew (bidi's \raggedright is
	% physical, not by direction).
	\ifdefempty{\shiur@printsize}{}{%
		\RequirePackage{fix-cm}%
		\RequirePackage{scrextend}%
		\changefontsizes{\shiur@printsize}%
		\geometry{headheight=1.25\dimexpr\shiur@printsize\relax}%
		\AtBeginDocument{\raggedright}%
		\AtBeginEnvironment{hebrew}{\raggedleft}%
	}

	\RequirePackage{fancyhdr}
	\renewcommand{\headrulewidth}{0pt}
	\fancyhf{}
	\fancyhead[R]{\begin{hebrew}בס״ד\end{hebrew}}
	\fancyfoot[L]{\thepage}
	\newcommand{\makeTitle}{\maketitle\thispagestyle{fancy}\pagestyle{fancy}}
}

