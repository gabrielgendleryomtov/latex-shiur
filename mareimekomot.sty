% Hebrew output needs polyglossia with Hebrew loaded; elsewhere the references
% come out in English.
%   \tanach{gen}{37:18-20}   בראשית ל״ז, י״ח–כ׳ / Genesis 37:18–20
%   \tanach*{gen}{39:1}      the same without the book's name
%   \tanach[rashi]{gen}{18:7}   רש״י על בראשית י״ח, ז׳ / Rashi on Genesis 18:7;
%                            \declarecommentary adds commentaries
%   \bavli[tosafot, dh=ואם תאמר, sv=ve'im tomar]{menachot}{69b}
%                            תוספות מנחות ס״ט ע״ב ד״ה ואם תאמר /
%                            Tosafot on B. Menaḥot 69b s.v. ve'im tomar
%   \bavli{menachot}{69b}    בבלי מנחות ס״ט ע״ב / B. Menaḥot 69b
%   \bavli*{69b}             the daf alone: ס״ט ע״ב / 69b
%   \mishnah{sukkah}{4:1}   משנה סוכה ד׳, א׳ / M. Sukkah 4:1
%   \yerushalmi{berachot}{1:1}  ירושלמי ברכות א׳, א׳ / Y. Berakhot 1:1
%   \rambam{shofar}{2:6}     משנה תורה הלכות שופר וסוכה ולולב ב׳, ו׳ /
%                            Mishneh Torah, Laws of Shofar, Sukkah and Lulav 2:6
%   \shulchanaruch{oh}{605:1}   שו״ע או״ח סי׳ תר״ה סע׳ א׳ / Shulḥan Arukh, Oraḥ Ḥayyim 605:1
%   \tur{oh}{605}            טור או״ח סי׳ תר״ה / Tur, Oraḥ Ḥayyim 605
%   \mishnahberurah{605:3}   משנה ברורה סי׳ תר״ה ס״ק ג׳ / Mishnah Berurah 605:3
%   and \beityosef, \darkeimoshe, \bach, \shach, \taz, \magenavraham and
%   \aruchhashulchan; \declaretursefer declares more. Commands with ח or כ in
%   their names can be spelt with kh too: \tanakh, \shulkhanarukh, \shakh, \bakh
%   (or \bah), \arukhhashulkhan.
%   \sham                    שם / ad loc; \sham[rashi] רש״י שם / Rashi ad loc
% Numbers follow the usual Hebrew convention: geresh for one letter (ח׳),
% gershayim before the last of several (ל״ח). Ranges take an en dash, the
% only place a reference can break across lines.

\RequirePackage{xspace}

% sham=full adds the reference \sham stands for, as "ad loc (B. Menaḥot
% 69b)"; daf=short writes a daf as ס״ט. and ס״ט: instead of ס״ט ע״א/ב.
\newif\ifmm@shamfull
\newif\ifmm@dafshort
\DeclareKeys[mareimekomot]{
	sham .choice:,
	sham / short .code = \mm@shamfullfalse,
	sham / full .code = \mm@shamfulltrue,
	daf .choice:,
	daf / long .code = \mm@dafshortfalse,
	daf / short .code = \mm@dafshorttrue,
}
\ProcessKeyOptions[mareimekomot]
\NewDocumentCommand{\mareimekomotsetup}{m}{\SetKeys[mareimekomot]{#1}}

\ExplSyntaxOn

%                         ***********
%                         ** NAMES **
%                         ***********

% Each name has a key, used in documents, and its Hebrew and English forms.
% Keys are listed with ch for ח and כ (menachot, berachot), but are matched
% loosely, so that any usual transliteration works: ignoring case, spaces,
% hyphens, dots and apostrophes, with kh, ch and h alike, tz, ts and z alike,
% y and i alike, doubled letters as single, and no final h. So menachot,
% menahot and Menakhot are all the same key. Some names have more than one
% key, for forms that differ beyond that (berachot, brachot). The English
% printed is transliterated with ḥ for ח and kh for כ.
\prop_new:N \g__mm_book_prop
\prop_new:N \g__mm_tractate_prop
\prop_new:N \g__mm_hilkhot_prop
\prop_new:N \g__mm_section_prop
\prop_new:N \g__mm_commentary_prop
\prop_new:N \g__mm_parashah_prop
% #1 property list, #2 keys, #3 Hebrew, #4 English
% While the package loads, two of its names matching alike is an error in the
% package; a document or package may redefine a name on purpose, and the new
% name then replaces the old one under all of the old one's keys too.
\cs_new_protected:Npn \__mm_name:Nnnn #1 #2 #3 #4
	{
		\bool_if:NF \g__mm_loading_bool { \__mm_rename:Nnn #1 {#2} { {#3} {#4} } }
		\clist_map_inline:nn {#2}
			{
				\__mm_normalise:Nn \l__mm_key_str {##1}
				\bool_if:NT \g__mm_loading_bool
					{
						\prop_get:NVNT #1 \l__mm_key_str \l__mm_names_tl
							{
								\tl_if_eq:nVF { {#3} {#4} } \l__mm_names_tl
									{ \msg_error:nnn { mareimekomot } { clash } {##1} }
							}
					}
				\prop_gput:NVn #1 \l__mm_key_str { {#3} {#4} }
			}
	}
% #1 property list, #2 keys, #3 new value: gives every key of the name that
% one of the keys has the new value
\seq_new:N \l__mm_rename_seq
\cs_new_protected:Npn \__mm_rename:Nnn #1 #2 #3
	{
		\tl_clear:N \l__mm_names_tl
		\clist_map_inline:nn {#2}
			{
				\__mm_normalise:Nn \l__mm_key_str {##1}
				\prop_get:NVNT #1 \l__mm_key_str \l__mm_names_tl { \clist_map_break: }
			}
		\tl_if_empty:NF \l__mm_names_tl
			{
				\seq_clear:N \l__mm_rename_seq
				\prop_map_inline:Nn #1
					{
						\tl_if_eq:nVT {##2} \l__mm_names_tl
							{ \seq_put_right:Nn \l__mm_rename_seq {##1} }
					}
				\seq_map_inline:Nn \l__mm_rename_seq { \prop_gput:Nnn #1 {##1} {#3} }
			}
	}
\cs_generate_variant:Nn \tl_if_eq:nnT { nV }
\bool_new:N \g__mm_loading_bool
\bool_gset_true:N \g__mm_loading_bool
\AtEndOfPackage { \bool_gset_false:N \g__mm_loading_bool }
\tl_new:N \l__mm_names_tl
\cs_generate_variant:Nn \tl_if_eq:nnF { nV }
\msg_new:nnn { mareimekomot } { clash }
	{ The~key~`#1'~matches~another~name's~key. }
\str_new:N \l__mm_key_str
\str_new:N \l__mm_loose_str
\str_new:N \l__mm_last_str
% #1 string variable, #2 key as written
\cs_new_protected:Npn \__mm_normalise:Nn #1 #2
	{
		\str_set:Ne #1 { \str_lowercase:n {#2} }
		\str_remove_all:Nn #1 { ~ }
		\str_remove_all:Nn #1 { - }
		\str_remove_all:Nn #1 { . }
		\str_remove_all:Nn #1 { ' }
		% a numeral at either end, as in samuelii or iisam, before i and ii could merge
		\regex_replace_once:nnN { \A ii } { 2 } #1
		\regex_replace_once:nnN { \A i } { 1 } #1
		\regex_replace_once:nnN { ii \Z } { 2 } #1
		\regex_replace_once:nnN { i \Z } { 1 } #1
		\regex_replace_all:nnN { [kc]h } { h } #1
		\regex_replace_all:nnN { t[sz] } { z } #1
		\regex_replace_all:nnN { y } { i } #1
		% doubled letters as single (l3regex has no backreferences)
		\str_clear:N \l__mm_loose_str
		\str_clear:N \l__mm_last_str
		\str_map_inline:Nn #1
			{
				\str_if_eq:nVF {##1} \l__mm_last_str
					{ \str_put_right:Nn \l__mm_loose_str {##1} }
				\str_set:Nn \l__mm_last_str {##1}
			}
		\regex_replace_once:nnN { h \Z } { } \l__mm_loose_str
		\str_set_eq:NN #1 \l__mm_loose_str
	}
\cs_generate_variant:Nn \str_if_eq:nnF { nV }
\cs_generate_variant:Nn \__mm_normalise:Nn { Ne }
