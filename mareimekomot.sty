%                         *************
%                         ** NUMBERS **
%                         *************

% whether the text around is Hebrew
\prg_new_conditional:Npnn \__mm_if_hebrew: { T, F, TF }
	{
		\str_if_eq:VnTF \languagename { hebrew }
			{ \prg_return_true: } { \prg_return_false: }
	}
% a number in the language around: letters with geresh or gershayim in Hebrew
\cs_new:Npn \__mm_number:n #1
	{ \__mm_if_hebrew:TF { \Hebrewnumeral {#1} } { #1 } }
% Not every font has an en dash (Taamey Frank CLM hasn't) or ḥ (Trebuchet MS
% hasn't), so these check the font in use: a range without an en dash takes a
% hyphen, and an ḥ is made from h and a dot below.
\cs_new_protected:Npn \__mm_dash:
	{ \tex_iffontchar:D \font "2013 \scan_stop: – \else: - \fi: }
\cs_new_protected:Npn \__mm_dotbelow:nn #1 #2
	{
		\tex_iffontchar:D \font #1 \scan_stop:
			\tex_char:D #1 \scan_stop:
		\else:
			\ooalign { #2 \cr \hidewidth \tex_lower:D 0.45ex \hbox { . } \hidewidth \cr }
		\fi:
	}
\cs_new_protected:Npn \__mm_h: { \__mm_dotbelow:nn { "1E25 } { h } }
\cs_new_protected:Npn \__mm_H: { \__mm_dotbelow:nn { "1E24 } { H } }

% A reference doesn't hyphenate: it can break between words of a long name
% (the Mishneh Torah's), and at the dash of a range, but not within a word.
\cs_new_protected:Npn \__mm_nohyphenation:
	{ \cs_if_exist:NT \l@nohyphenation { \tex_language:D = \l@nohyphenation } }
% #1 name list, #2 key; leaves the Hebrew and English names in \l__mm_he_tl
% and \l__mm_en_tl
\tl_new:N \l__mm_he_tl
\tl_new:N \l__mm_en_tl
\tl_new:N \l__mm_names_tl
\cs_new_protected:Npn \__mm_lookup:Nnn #1 #2 #3
	{
		\__mm_nohyphenation:
		\__mm_normalise:Nn \l__mm_key_str {#2}
		\prop_get:NVNTF #1 \l__mm_key_str \l__mm_names_tl
			{
				\tl_set:Ne \l__mm_he_tl { \exp_after:wN \use_i:nn \l__mm_names_tl }
				\tl_set:Ne \l__mm_en_tl { \exp_after:wN \use_ii:nn \l__mm_names_tl }
			}
			{
				\msg_error:nnn { mareimekomot } { unknown-name } {#2}
				\tl_set:Nn \l__mm_he_tl {#2}
				\tl_set:Nn \l__mm_en_tl {#2}
			}
	}
\msg_new:nnn { mareimekomot } { unknown-name }
	{ Unknown~name~`#1'.~See~the~lists~of~books~and~tractates~in~mareimekomot.sty. }
\msg_new:nnn { mareimekomot } { bad-reference }
	{ Can't~read~the~reference~`#1'. }

%                         ************
%                         ** TANAKH **
%                         ************

% the document's colon is an ordinary character, unlike expl3's
\cs_generate_variant:Nn \seq_set_split:Nnn { Nee }
\seq_new:N \l__mm_range_seq
\seq_new:N \l__mm_from_seq
\seq_new:N \l__mm_to_seq
% #1 reference: 37, 37:18, 37:18-20, 37:18-38:2 or 37-38
\cs_new_protected:Npn \__mm_tanakh_ref:n #1
	{
		\seq_set_split:Nnn \l__mm_range_seq { - } {#1}
		\seq_set_split:Nee \l__mm_from_seq { \c_colon_str }
			{ \seq_item:Nn \l__mm_range_seq { 1 } }
		\int_compare:nNnTF { \seq_count:N \l__mm_range_seq } > 1
			{
				\seq_set_split:Nee \l__mm_to_seq { \c_colon_str }
					{ \seq_item:Nn \l__mm_range_seq { 2 } }
			}
			{ \seq_clear:N \l__mm_to_seq }
		% from: chapter, or chapter and verse
		\__mm_number:n { \seq_item:Nn \l__mm_from_seq { 1 } }
		\int_compare:nNnT { \seq_count:N \l__mm_from_seq } > 1
			{ \__mm_chapter_verse_sep: \__mm_number:n { \seq_item:Nn \l__mm_from_seq { 2 } } }
		% to: a verse in the same chapter, another chapter and verse, or a chapter
		\seq_if_empty:NF \l__mm_to_seq
			{
				\__mm_dash:
				\__mm_number:n { \seq_item:Nn \l__mm_to_seq { 1 } }
				\int_compare:nNnT { \seq_count:N \l__mm_to_seq } > 1
					{ \__mm_chapter_verse_sep: \__mm_number:n { \seq_item:Nn \l__mm_to_seq { 2 } } }
			}
	}
\cs_new:Npn \__mm_chapter_verse_sep:
	{ \__mm_if_hebrew:TF { , \nobreakspace } { \c_colon_str } }

% \tanakh{book}{reference}; the starred form leaves out the book's name
\NewDocumentCommand \tanakh { s m m }
	{
		\group_begin:
		\__mm_lookup:Nnn \g__mm_book_prop {#2} { }
		\IfBooleanF {#1}
			{ \__mm_if_hebrew:TF { \l__mm_he_tl } { \l__mm_en_tl } \nobreakspace }
		\__mm_tanakh_ref:n {#3}
		\__mm_remember:n { \tanakh {#2} {#3} }
		\group_end:
	}

%                         ************
%                         ** TALMUD **
%                         ************

% #1 daf as 69b, 69 or 69b-70a (or 69a-b)
\cs_new_protected:Npn \__mm_daf:n #1
	{
		\seq_set_split:Nnn \l__mm_range_seq { - } {#1}
		\__mm_page:e { \seq_item:Nn \l__mm_range_seq { 1 } }
		\int_compare:nNnT { \seq_count:N \l__mm_range_seq } > 1
			{
				\__mm_dash:
				\__mm_page:e { \seq_item:Nn \l__mm_range_seq { 2 } }
			}
	}
% #1 one page: 69b, 69, or just b
\cs_new_protected:Npn \__mm_page:n #1
	{
		\regex_extract_once:nnNTF { \A ([0-9]*) ([abAB]?) \Z } {#1} \l_tmpa_seq
			{
				\tl_set:Ne \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
				\tl_set:Ne \l_tmpb_tl { \str_lowercase:e { \seq_item:Nn \l_tmpa_seq { 3 } } }
				\__mm_if_hebrew:TF { \__mm_hebrew_page: } { \l_tmpa_tl \l_tmpb_tl }
			}
			{ \msg_error:nnn { mareimekomot } { bad-reference } {#1} #1 }
	}
\cs_generate_variant:Nn \__mm_page:n { e }
\cs_generate_variant:Nn \str_lowercase:n { e }
% the page in \l_tmpa_tl, the side (a, b or empty) in \l_tmpb_tl
\cs_new_protected:Npn \__mm_hebrew_page:
	{
		\legacy_if:nTF { mm@dafshort }
			{
				% the traditional short form: a full stop for the first side, a colon
				% for the second
				\tl_if_empty:NF \l_tmpa_tl { \hebrewnumeral { \l_tmpa_tl } }
				\str_case:Vn \l_tmpb_tl { { a } { . } { b } { : } }
			}
			{
				\tl_if_empty:NF \l_tmpa_tl
					{ \Hebrewnumeral { \l_tmpa_tl } \tl_if_empty:NF \l_tmpb_tl { \nobreakspace } }
				\str_case:Vn \l_tmpb_tl { { a } { ע״א } { b } { ע״ב } }
			}
	}

% \bavli{tractate}{daf}; \bavli*{daf} is the daf alone, which doesn't change what
% \sham stands for
\NewDocumentCommand \bavli { s }
	{ \IfBooleanTF {#1} { \__mm_bavli_daf:n } { \__mm_bavli:nn } }
\cs_new_protected:Npn \__mm_bavli:nn #1 #2
	{
		\group_begin:
		\__mm_lookup:Nnn \g__mm_tractate_prop {#1} { }
		\__mm_if_hebrew:TF { בבלי \nobreakspace \l__mm_he_tl } { B. \nobreakspace \l__mm_en_tl }
		\nobreakspace
		\__mm_daf:n {#2}
		\__mm_remember:n { \bavli {#1} {#2} }
		\group_end:
	}
\cs_new_protected:Npn \__mm_bavli_daf:n #1
	{ \group_begin: \__mm_nohyphenation: \__mm_daf:n {#1} \group_end: }

%                         ************************************
%                         ** MISHNAH, YERUSHALMI AND RAMBAM **
%                         ************************************

% These take a chapter and its mishnah, halakhah or law, written like a
% Tanakh reference (4:1, 4:1-3).
% #1 Hebrew prefix, #2 English prefix, #3 name list, #4 key, #5 reference
\cs_new_protected:Npn \__mm_chapter_work:nnNnn #1 #2 #3 #4 #5
	{
		\group_begin:
		\__mm_lookup:Nnn #3 {#4} { }
		\__mm_if_hebrew:TF { #1 \l__mm_he_tl } { #2 \l__mm_en_tl }
		\nobreakspace
		\__mm_tanakh_ref:n {#5}
		\group_end:
	}
\NewDocumentCommand \mishnah { m m }
	{
		\__mm_chapter_work:nnNnn { משנה \nobreakspace } { M. \nobreakspace }
			\g__mm_tractate_prop {#1} {#2}
		\__mm_remember:n { \mishnah {#1} {#2} }
	}
\NewDocumentCommand \yerushalmi { m m }
	{
		\__mm_chapter_work:nnNnn { ירושלמי \nobreakspace } { Y. \nobreakspace }
			\g__mm_tractate_prop {#1} {#2}
		\__mm_remember:n { \yerushalmi {#1} {#2} }
	}
\NewDocumentCommand \rambam { m m }
	{
		\__mm_chapter_work:nnNnn
			{ משנה \nobreakspace תורה ~ הלכות ~ }
			{ Mishneh \nobreakspace Torah, ~ Laws ~ of ~ }
			\g__mm_hilkhot_prop {#1} {#2}
		\__mm_remember:n { \rambam {#1} {#2} }
	}

%                         ******************************
%                         ** TUR AND SHULCHAN ARUKH **
%                         ******************************

% A siman and its se'if: 605, 605:1, 658:1-2 or 605:1-606:2. In Hebrew,
% סי׳ תר״ה סע׳ א׳; in English, 605:1.
\cs_new_protected:Npn \__mm_siman_ref:n #1
	{
		\__mm_if_hebrew:TF
			{
				\seq_set_split:Nnn \l__mm_range_seq { - } {#1}
				\seq_set_split:Nee \l__mm_from_seq { \c_colon_str }
					{ \seq_item:Nn \l__mm_range_seq { 1 } }
				\int_compare:nNnTF { \seq_count:N \l__mm_range_seq } > 1
					{
						\seq_set_split:Nee \l__mm_to_seq { \c_colon_str }
							{ \seq_item:Nn \l__mm_range_seq { 2 } }
					}
					{ \seq_clear:N \l__mm_to_seq }
				סי׳ \nobreakspace \__mm_number:n { \seq_item:Nn \l__mm_from_seq { 1 } }
				\int_compare:nNnT { \seq_count:N \l__mm_from_seq } > 1
					{ \nobreakspace סע׳ \nobreakspace \__mm_number:n { \seq_item:Nn \l__mm_from_seq { 2 } } }
				\seq_if_empty:NF \l__mm_to_seq
					{
						\__mm_dash:
						\int_compare:nNnTF { \seq_count:N \l__mm_to_seq } > 1
							{
								% into another siman
								סי׳ \nobreakspace \__mm_number:n { \seq_item:Nn \l__mm_to_seq { 1 } }
								\nobreakspace סע׳ \nobreakspace \__mm_number:n { \seq_item:Nn \l__mm_to_seq { 2 } }
							}
							{ \__mm_number:n { \seq_item:Nn \l__mm_to_seq { 1 } } }
					}
			}
			{ \__mm_tanakh_ref:n {#1} }
	}
% #1 Hebrew name, #2 English name, #3 section key, #4 reference
\cs_new_protected:Npn \__mm_code:nnnn #1 #2 #3 #4
	{
		\group_begin:
		\__mm_lookup:Nnn \g__mm_section_prop {#3} { }
		\__mm_if_hebrew:TF { #1 \nobreakspace \l__mm_he_tl } { #2, ~ \l__mm_en_tl }
		\nobreakspace
		\__mm_siman_ref:n {#4}
		\group_end:
	}
\NewDocumentCommand \shulchanaruch { m m }
	{
		\__mm_code:nnnn { שו״ע } { Shul \__mm_h: an \nobreakspace Arukh } {#1} {#2}
		\__mm_remember:n { \shulchanaruch {#1} {#2} }
	}
\NewDocumentCommand \tur { m m }
	{
		\__mm_code:nnnn { טור } { Tur } {#1} {#2}
		\__mm_remember:n { \tur {#1} {#2} }
	}

%                         ************
%                         ** AD LOC **
%                         ************

% The last reference made, which \sham stands for. A document that says
% "Rashi ad loc" after a source with no reference of ours would make \sham
% wrong, so shiur clears it at each source that doesn't make one.
\tl_new:N \g__mm_last_tl
\bool_new:N \g__mm_referred_bool
\cs_new_protected:Npn \__mm_remember:n #1
	{
		\tl_gset:Nn \g__mm_last_tl {#1}
		\bool_gset_true:N \g__mm_referred_bool
	}
% for packages: forget the last reference, or note that one was made since
\cs_new_protected:Npn \mareimekomot@forget { \tl_gclear:N \g__mm_last_tl }
\cs_new_protected:Npn \mareimekomot@startunit { \bool_gset_false:N \g__mm_referred_bool }
\cs_new_protected:Npn \mareimekomot@endunit
	{ \bool_if:NF \g__mm_referred_bool { \tl_gclear:N \g__mm_last_tl } }

\NewDocumentCommand \sham { }
	{
		\__mm_if_hebrew:TF { שם } { ad~loc }
		\legacy_if:nT { mm@shamfull }
			{
				\tl_if_empty:NF \g__mm_last_tl
					{
						\c_space_tl (
						\group_begin:
						% within the parentheses, \sham's own reference doesn't change
						\cs_set_eq:NN \__mm_remember:n \use_none:n
						\g__mm_last_tl
						\group_end:
						)
					}
			}
		\bool_gset_true:N \g__mm_referred_bool
		\xspace
	}

\ExplSyntaxOff
