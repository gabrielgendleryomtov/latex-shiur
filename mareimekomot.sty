% \declaresefer[english={template}]{keys}{Hebrew name}{English name}{template}
% declares a work cited as \sefer{key}{...}{...}. The template is what follows
% the name, with a placeholder for each argument, taken in order:
%   #N  a number or range (4, 10-12): ד׳ / 4
%   #R  a chapter and verse, as in \tanach (38:13, 5:1-3): ל״ח, י״ג / 38:13
%   #D  a daf (69b): ס״ט ע״ב / 69b
%   #T  a section of the Tur (oh, yd, eh, chm): או״ח / Oraḥ Ḥayyim
%   #B  a book of Tanakh, #M a tractate, #P a parashah (noach), #H a set of
%       laws of the Mishneh Torah (shofar)
%   #S  any text, printed as written, or {Hebrew}{English} for each language
% The template is used in both languages unless english= gives English its own,
% with the same placeholders in the same order. A space before #N, #R or #D
% doesn't break, which keeps a number with its label. So
%   \declaresefer[english={, #T #N:#N}]{igrotmoshe}{אגרות משה}{Igrot Moshe}
%     { #T חלק #N סי׳ #N}
%   \sefer{igrotmoshe}{yd}{1}{62}   אגרות משה יו״ד חלק א׳ סי׳ ס״ב /
%                                   Igrot Moshe, Yoreh De'ah 1:62
% \sefer* leaves out the name, and whatever comes before the first placeholder.
% A later declaration of a work, in a document or another package, replaces the
% earlier one, under all of the earlier one's keys as well as its own.
\prop_new:N \g__mm_sefer_prop
\tl_new:N \l__mm_he_template_tl
\tl_new:N \l__mm_en_template_tl
\tl_new:N \l__mm_template_tl
\str_new:N \l__mm_id_str
\str_new:N \l__mm_he_slots_str
\str_new:N \l__mm_en_slots_str
\seq_new:N \l__mm_slots_seq
\keys_define:nn { mareimekomot / sefer }
	{ english .tl_set:N = \l__mm_en_template_tl }
\cs_generate_variant:Nn \regex_extract_all:nnN { nV }
\cs_generate_variant:Nn \regex_match:nnF { nV }
\cs_generate_variant:Nn \prop_gput:Nnn { NVV }
\cs_generate_variant:Nn \str_if_eq:nnF { VV }
\msg_new:nnn { mareimekomot } { bad-placeholder }
	{
		The~template~of~`#1'~has~a~placeholder~that~isn't~one~of~
		\iow_char:N\#N,~\iow_char:N\#R,~\iow_char:N\#D,~\iow_char:N\#T,~
		\iow_char:N\#B,~\iow_char:N\#M,~\iow_char:N\#P,~\iow_char:N\#H~and~\iow_char:N\#S.
	}
\msg_new:nnn { mareimekomot } { template-mismatch }
	{ The~English~template~of~`#1'~has~different~placeholders~from~the~Hebrew~one. }
\NewDocumentCommand \declaresefer { O{} m m m m }
	{
		% no group: the work must outlive the declaration
		\tl_set:Nn \l__mm_he_template_tl {#5}
		\tl_set:Nn \l__mm_en_template_tl {#5}
		\keys_set:nn { mareimekomot / sefer } {#1}
		\__mm_template:NNn \l__mm_he_template_tl \l__mm_he_slots_str {#2}
		\__mm_template:NNn \l__mm_en_template_tl \l__mm_en_slots_str {#2}
		\str_if_eq:VVF \l__mm_he_slots_str \l__mm_en_slots_str
			{ \msg_error:nnn { mareimekomot } { template-mismatch } {#2} }
		% The work is stored under an id, which all its keys lead to: its first key,
		% or, once the package has loaded, the id of the work it replaces, so that a
		% document's or package's own Igrot Moshe takes every key of the built-in one
		\str_clear:N \l__mm_id_str
		\bool_if:NF \g__mm_loading_bool
			{
				\clist_map_inline:nn {#2}
					{
						\__mm_normalise:Nn \l__mm_key_str {##1}
						\prop_get:NVNT \g__mm_sefer_prop \l__mm_key_str \l__mm_names_tl
							{
								\str_set:NV \l__mm_id_str \l__mm_names_tl
								\clist_map_break:
							}
					}
			}
		\str_if_empty:NT \l__mm_id_str
			{ \__mm_normalise:Ne \l__mm_id_str { \clist_item:nn {#2} { 1 } } }
		\clist_map_inline:nn {#2}
			{
				\__mm_normalise:Nn \l__mm_key_str {##1}
				\bool_if:NT \g__mm_loading_bool
					{
						\prop_get:NVNT \g__mm_sefer_prop \l__mm_key_str \l__mm_names_tl
							{
								\str_if_eq:VVF \l__mm_names_tl \l__mm_id_str
									{ \msg_error:nnn { mareimekomot } { clash } {##1} }
							}
					}
				\prop_gput:NVV \g__mm_sefer_prop \l__mm_key_str \l__mm_id_str
			}
		\tl_gclear_new:c { g__mm_sefer_ \l__mm_id_str _he_name_tl }
		\tl_gset:cn { g__mm_sefer_ \l__mm_id_str _he_name_tl } {#3}
		\tl_gclear_new:c { g__mm_sefer_ \l__mm_id_str _en_name_tl }
		\tl_gset:cn { g__mm_sefer_ \l__mm_id_str _en_name_tl } {#4}
		\tl_gclear_new:c { g__mm_sefer_ \l__mm_id_str _he_tl }
		\tl_gset_eq:cN { g__mm_sefer_ \l__mm_id_str _he_tl } \l__mm_he_template_tl
		\tl_gclear_new:c { g__mm_sefer_ \l__mm_id_str _en_tl }
		\tl_gset_eq:cN { g__mm_sefer_ \l__mm_id_str _en_tl } \l__mm_en_template_tl
		\int_gzero_new:c { g__mm_sefer_ \l__mm_id_str _int }
		\int_gset:cn { g__mm_sefer_ \l__mm_id_str _int } { \str_count:N \l__mm_he_slots_str }
	}
% #1 template, which becomes text with \__mm_slot:n {N} for each #N; #2 string
% variable for its placeholders' letters in order (NN for Igrot Moshe's); #3 keys
\cs_new_protected:Npn \__mm_template:NNn #1 #2 #3
	{
		\regex_extract_all:nVN { \cP. (.) } #1 \l__mm_slots_seq
		\str_clear:N #2
		% each match comes as itself and then its letter
		\int_step_inline:nnnn { 2 } { 2 } { \seq_count:N \l__mm_slots_seq }
			{ \str_put_right:Ne #2 { \seq_item:Nn \l__mm_slots_seq {##1} } }
		\regex_match:nVF { \A [NRDTBMPHS]* \Z } #2
			{ \msg_error:nnn { mareimekomot } { bad-placeholder } {#3} }
		\regex_replace_all:nnN { \x20 (\cP. [NRD]) } { \c{nobreakspace} \1 } #1
		\regex_replace_all:nnN { \cP. (.) } { \c{__mm_slot:n} \cB\{ \1 \cE\} } #1
	}

\bool_new:N \l__mm_star_bool
\tl_new:N \l__mm_call_tl
\tl_new:N \l__mm_arg_tl
