\NewDocumentCommand \declarecommentary { m m m }
	{ \__mm_commentary:nnn {#1} {#2} {#3} }

% A commentary's optional argument: its key, and the words it opens with, dh=
% for Hebrew and sv= for English (either alone serves both): [tosafot, dh=ואם
% תאמר, sv=ve'im tomar] gives ד״ה ואם תאמר / s.v. ve'im tomar after the reference.
\tl_new:N \l__mm_commentary_tl
\tl_new:N \l__mm_dh_tl
\tl_new:N \l__mm_sv_tl
\keys_define:nn { mareimekomot / commentary }
	{
		dh .tl_set:N = \l__mm_dh_tl,
		sv .tl_set:N = \l__mm_sv_tl,
	}
% #1 the optional argument, or -NoValue-
\cs_new_protected:Npn \__mm_commentary_options:n #1
	{
		\tl_clear:N \l__mm_commentary_tl
		\tl_clear:N \l__mm_dh_tl
		\tl_clear:N \l__mm_sv_tl
		\IfValueT {#1}
			{
				\clist_map_inline:nn {#1}
					{
						\tl_if_in:nnTF {##1} { = }
							{ \keys_set:nn { mareimekomot / commentary } {##1} }
							{ \tl_set:Nn \l__mm_commentary_tl {##1} }
					}
			}
	}
% the commentary's name and #1 ("על" / "on") before it, if there is one
\cs_new_protected:Npn \__mm_commentator:nn #1 #2
	{
		\tl_if_empty:NF \l__mm_commentary_tl
			{
				\__mm_lookup:NVn \g__mm_commentary_prop \l__mm_commentary_tl { }
				\__mm_if_hebrew:TF { \l__mm_he_tl #1 } { \l__mm_en_tl #2 }
				\c_space_tl
			}
	}
\cs_generate_variant:Nn \__mm_lookup:Nnn { NV }
% the opening words, after the reference
\cs_new_protected:Npn \__mm_dibbur:
	{
		\__mm_if_hebrew:TF
			{
				\tl_if_empty:NTF \l__mm_dh_tl
					{ \tl_if_empty:NF \l__mm_sv_tl { \c_space_tl ד״ה \nobreakspace \l__mm_sv_tl } }
					{ \c_space_tl ד״ה \nobreakspace \l__mm_dh_tl }
			}
			{
				\tl_if_empty:NTF \l__mm_sv_tl
					{
						\tl_if_empty:NF \l__mm_dh_tl
							{
								\c_space_tl s.v. \nobreakspace
								\cs_if_exist:NTF \texthebrew { \texthebrew { \l__mm_dh_tl } } { \l__mm_dh_tl }
							}
					}
					{ \c_space_tl s.v. \nobreakspace \l__mm_sv_tl }
			}
	}

\NewDocumentCommand \tanach { s o m m }
	{
		\group_begin:
		\__mm_commentary_options:n {#2}
		\__mm_commentator:nn { \nobreakspace על } { \nobreakspace on }
		\__mm_lookup:Nnn \g__mm_book_prop {#3} { }
		\IfBooleanF {#1}
			{ \__mm_if_hebrew:TF { \l__mm_he_tl } { \l__mm_en_tl } \nobreakspace }
		\__mm_tanakh_ref:n {#4}
		\__mm_dibbur:
		% the verse itself, so that "Ibn Ezra \sham" after Rashi means the verse
		\__mm_remember:n { \tanach {#3} {#4} }
