				\__mm_if_hebrew:TF { #1 \nobreakspace \l__mm_he_tl } { #2, ~ \l__mm_en_tl }
			}
		\nobreakspace
		\__mm_siman_ref:n {#5}
		\group_end:
	}

% \declaretursefer[keys]{\command}{Hebrew name}{English name} declares a work
% arranged by the Tur's four sections, simanim and se'ifim. Keys:
%   seifkatan     its sub-unit is the se'if katan (ס״ק), as in commentaries
%   subunit=...   any other Hebrew sub-unit, such as אות
%   section=oh    it covers one section only: the command then takes just the
%                 reference, and the section isn't named
% A declared command takes {section}{reference}, as \shulchanaruch{oh}{605:1},
% or just {reference} for a one-section work, as \mishnahberurah{605:3}.
\tl_new:N \l__mm_decl_subunit_tl
\tl_new:N \l__mm_decl_section_tl
\keys_define:nn { mareimekomot / tursefer }
	{
		seifkatan .code:n = \tl_set:Nn \l__mm_decl_subunit_tl { ס״ק },
		seifkatan .value_forbidden:n = true,
		subunit .tl_set:N = \l__mm_decl_subunit_tl,
		section .tl_set:N = \l__mm_decl_section_tl,
