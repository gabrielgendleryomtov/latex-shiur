% Each name has a key, used in documents, and its Hebrew and English forms.
% Keys are matched ignoring case, spaces, hyphens, dots and apostrophes, and
% some names have more than one key.
\prop_new:N \g__mm_book_prop
\prop_new:N \g__mm_tractate_prop
% #1 property list, #2 keys, #3 Hebrew, #4 English
\cs_new_protected:Npn \__mm_name:Nnnn #1 #2 #3 #4
	{
		\clist_map_inline:nn {#2}
			{
				\__mm_normalise:Nn \l__mm_key_str {##1}
				\prop_gput:NVn #1 \l__mm_key_str { {#3} {#4} }
			}
	}
\str_new:N \l__mm_key_str
% #1 string variable, #2 key as written
\cs_new_protected:Npn \__mm_normalise:Nn #1 #2
	{
		\str_set:Ne #1 { \str_lowercase:n {#2} }
		\str_remove_all:Nn #1 { ~ }
		\str_remove_all:Nn #1 { - }
		\str_remove_all:Nn #1 { . }
		\str_remove_all:Nn #1 { ' }
	}
\cs_new_protected:Npn \__mm_book:nnn { \__mm_name:Nnnn \g__mm_book_prop }
\cs_new_protected:Npn \__mm_tractate:nnn { \__mm_name:Nnnn \g__mm_tractate_prop }

