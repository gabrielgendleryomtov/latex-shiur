		\tl_clear:N \l__mm_decl_section_tl
		\keys_set:nn { mareimekomot / tursefer } {#1}
		\__mm_declare:NnnVV #2 {#3} {#4} \l__mm_decl_subunit_tl \l__mm_decl_section_tl
	}
