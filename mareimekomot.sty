% the document's colon is an ordinary character, unlike expl3's
\cs_generate_variant:Nn \seq_set_split:Nnn { Nee }
\seq_new:N \l__mm_range_seq
\seq_new:N \l__mm_from_seq
\seq_new:N \l__mm_to_seq
% #1 reference: 37, 37:18, 37:18-20, 37:18-38:2 or 37-38
\cs_new_protected:Npn \__mm_tanakh_ref:n #1
	{
		\seq_set_split:Nnn \l__mm_range_seq { - } {#1}
		\seq_set_split:Nee \l__mm_from_seq { \c_colon_str }
			{ \seq_item:Nn \l__mm_range_seq { 1 } }
		\int_compare:nNnTF { \seq_count:N \l__mm_range_seq } > 1
			{
				\seq_set_split:Nee \l__mm_to_seq { \c_colon_str }
					{ \seq_item:Nn \l__mm_range_seq { 2 } }
			}
			{ \seq_clear:N \l__mm_to_seq }
		% from: chapter, or chapter and verse
		\__mm_number:n { \seq_item:Nn \l__mm_from_seq { 1 } }
		\int_compare:nNnT { \seq_count:N \l__mm_from_seq } > 1
			{ \__mm_chapter_verse_sep: \__mm_number:n { \seq_item:Nn \l__mm_from_seq { 2 } } }
		% to: a verse in the same chapter, another chapter and verse, or a chapter
		\seq_if_empty:NF \l__mm_to_seq
			{
				\__mm_dash:
				\__mm_number:n { \seq_item:Nn \l__mm_to_seq { 1 } }
				\int_compare:nNnT { \seq_count:N \l__mm_to_seq } > 1
					{ \__mm_chapter_verse_sep: \__mm_number:n { \seq_item:Nn \l__mm_to_seq { 2 } } }
			}
	}
\cs_new:Npn \__mm_chapter_verse_sep:
	{ \__mm_if_hebrew:TF { , \nobreakspace } { \c_colon_str } }

% \tanakh{book}{reference}; the starred form leaves out the book's name
% Commentaries on a verse, for \tanakh[rashi]{gen}{18:7}: רש״י על בראשית י״ח, ז׳ /
% Rashi on Genesis 18:7. \declarecommentary{keys}{Hebrew}{English} adds more.
\__mm_commentary:nnn { rashi } { רש״י } { Rashi }
\__mm_commentary:nnn { ramban, nachmanides } { רמב״ן } { Ramban }
\__mm_commentary:nnn { ibnezra } { אבן\nobreakspace עזרא } { Ibn\nobreakspace Ezra }
\__mm_commentary:nnn { rashbam } { רשב״ם } { Rashbam }
\__mm_commentary:nnn { radak } { רד״ק } { Radak }
\__mm_commentary:nnn { seforno, sforno } { ספורנו } { Seforno }
\__mm_commentary:nnn { chizkuni } { חזקוני } { \__mm_H: izkuni }
\__mm_commentary:nnn { orhachaim } { אור\nobreakspace החיים } { Or\nobreakspace ha\__mm_H: ayyim }
\__mm_commentary:nnn { baalhaturim } { בעל\nobreakspace הטורים } { Ba'al\nobreakspace haTurim }
\__mm_commentary:nnn { keliyakar, kliyakar } { כלי\nobreakspace יקר } { Keli\nobreakspace Yakar }
\__mm_commentary:nnn { malbim } { מלבי״ם } { Malbim }
\__mm_commentary:nnn { onkelos, targumonkelos } { תרגום\nobreakspace אונקלוס } { Targum\nobreakspace Onkelos }
\__mm_commentary:nnn { yonatan, targumyonatan, jonathan } { תרגום\nobreakspace יונתן } { Targum\nobreakspace Yonatan }
\NewDocumentCommand \declarecommentary { m m m }
	{ \__mm_commentary:nnn {#1} {#2} {#3} }

\NewDocumentCommand \tanach { s o m m }
	{
		\group_begin:
		\IfValueT {#2}
			{
				\__mm_lookup:Nnn \g__mm_commentary_prop {#2} { }
				\__mm_if_hebrew:TF
					{ \l__mm_he_tl \nobreakspace על }
					{ \l__mm_en_tl \nobreakspace on }
				\c_space_tl
			}
		\__mm_lookup:Nnn \g__mm_book_prop {#3} { }
		\IfBooleanF {#1}
			{ \__mm_if_hebrew:TF { \l__mm_he_tl } { \l__mm_en_tl } \nobreakspace }
		\__mm_tanakh_ref:n {#4}
		% the verse itself, so that "Ibn Ezra \sham" after Rashi means the verse
		\__mm_remember:n { \tanach {#3} {#4} }
		\group_end:
	}
% the same, spelt with kh
\NewCommandCopy \tanakh \tanach

